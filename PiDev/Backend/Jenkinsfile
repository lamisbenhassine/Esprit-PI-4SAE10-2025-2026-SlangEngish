pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dii07')
        DOCKER_USERNAME       = 'dii07'
        IMAGE_TAG             = "${BUILD_NUMBER}"
        SONAR_PROJECT_KEY     = 'pidev-school-service'
    }

    stages {

        // ─────────────────────────────────────────────────
        stage('Checkout') {
        // ─────────────────────────────────────────────────
            steps {
                git branch: 'gestion-des-offres',
                    credentialsId: 'hamzaty',
                    url: 'https://github.com/lamisbenhassine/Esprit-PI-4SAE10-2025-2026-SlangEngish.git'
            }
        }

        // ─────────────────────────────────────────────────
        stage('Build - Maven') {
        // ─────────────────────────────────────────────────
            steps {
                dir('PiDev/Backend') {
                    sh 'mvn clean package -DskipTests'
                }
            }
            post {
                success { echo 'Maven build succeeded.' }
                failure { error 'Maven build FAILED — aborting pipeline.' }
            }
        }

        // ─────────────────────────────────────────────────
        stage('Test - JUnit + JaCoCo') {
        // ─────────────────────────────────────────────────
            steps {
                dir('PiDev/Backend/school-service') {
                    sh 'mvn verify'
                }
            }
            post {
                always {
                    junit 'PiDev/Backend/school-service/target/surefire-reports/*.xml'
                    jacoco(
                        execPattern: 'PiDev/Backend/school-service/target/jacoco.exec',
                        classPattern:  'PiDev/Backend/school-service/target/classes',
                        sourcePattern: 'PiDev/Backend/school-service/src/main/java'
                    )
                }
            }
        }

        // ─────────────────────────────────────────────────
        stage('SonarQube Analysis') {
        // ─────────────────────────────────────────────────
            steps {
                dir('PiDev/Backend/school-service') {
                    withSonarQubeEnv('SonarQube') {
                        sh "mvn sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY} -Dsonar.projectName='PiDev School Service' -Dsonar.java.binaries=target/classes -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml -Dsonar.junit.reportPaths=target/surefire-reports"
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────
        stage('Quality Gate') {
        // ─────────────────────────────────────────────────
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────
        stage('Docker Build') {
        // ─────────────────────────────────────────────────
            parallel {
                stage('Build eureka-server') {
                    steps {
                        dir('PiDev/Backend/eureka-server') {
                            sh "docker build -t ${DOCKER_USERNAME}/pidev-eureka-server:${IMAGE_TAG} ."
                        }
                    }
                }
                stage('Build api-gateway') {
                    steps {
                        dir('PiDev/Backend/api-gateway') {
                            sh "docker build -t ${DOCKER_USERNAME}/pidev-api-gateway:${IMAGE_TAG} ."
                        }
                    }
                }
                stage('Build school-service') {
                    steps {
                        dir('PiDev/Backend/school-service') {
                            sh "docker build -t ${DOCKER_USERNAME}/pidev-school-service:${IMAGE_TAG} ."
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────
        stage('Trivy Security Scan') {
        // ─────────────────────────────────────────────────
            steps {
                sh """
                    trivy image \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format table \
                        --output trivy-report.txt \
                        ${DOCKER_USERNAME}/pidev-school-service:${IMAGE_TAG}

                    trivy image \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format table \
                        ${DOCKER_USERNAME}/pidev-eureka-server:${IMAGE_TAG}

                    trivy image \
                        --exit-code 0 \
                        --severity HIGH,CRITICAL \
                        --format table \
                        ${DOCKER_USERNAME}/pidev-api-gateway:${IMAGE_TAG}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.txt', allowEmptyArchive: true
                }
            }
        }

        // ─────────────────────────────────────────────────
        stage('Docker Push') {
        // ─────────────────────────────────────────────────
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                sh """
                    # Push versioned tags
                    docker push ${DOCKER_USERNAME}/pidev-eureka-server:${IMAGE_TAG}
                    docker push ${DOCKER_USERNAME}/pidev-api-gateway:${IMAGE_TAG}
                    docker push ${DOCKER_USERNAME}/pidev-school-service:${IMAGE_TAG}

                    # Tag and push latest
                    docker tag ${DOCKER_USERNAME}/pidev-eureka-server:${IMAGE_TAG}  ${DOCKER_USERNAME}/pidev-eureka-server:latest
                    docker tag ${DOCKER_USERNAME}/pidev-api-gateway:${IMAGE_TAG}    ${DOCKER_USERNAME}/pidev-api-gateway:latest
                    docker tag ${DOCKER_USERNAME}/pidev-school-service:${IMAGE_TAG} ${DOCKER_USERNAME}/pidev-school-service:latest

                    docker push ${DOCKER_USERNAME}/pidev-eureka-server:latest
                    docker push ${DOCKER_USERNAME}/pidev-api-gateway:latest
                    docker push ${DOCKER_USERNAME}/pidev-school-service:latest
                """
            }
        }

    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "CI pipeline #${BUILD_NUMBER} completed — images pushed to DockerHub."
        }
        failure {
            echo "CI pipeline #${BUILD_NUMBER} FAILED."
        }
    }
}

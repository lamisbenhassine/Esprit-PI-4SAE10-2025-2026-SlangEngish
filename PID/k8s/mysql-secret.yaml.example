# Copier vers mysql-secret.yaml et remplacer CHANGE_ME puis :
#   kubectl apply -f mysql-secret.yaml
# Ne pas committer mysql-secret.yaml avec un vrai mot de passe.
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: slangenglish
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "CHANGE_ME"

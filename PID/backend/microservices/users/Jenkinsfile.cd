pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
    }

    environment {
        IMAGE_NAME = 'slangenglish/user-service'
        CONTAINER_NAME = 'user-service'
        APP_PORT = '8011'
        HOST_PORT = '8011'
        SONAR_PROJECT_KEY = 'slangenglish-user-service'
        SONARQUBE_SERVER = 'sonarqube-server'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'chmod +x mvnw'
                        sh './mvnw -B clean test'
                    } else {
                        bat 'mvnw.cmd -B clean test'
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    withSonarQubeEnv("${SONARQUBE_SERVER}") {
                        if (isUnix()) {
                            sh "./mvnw -B sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY}"
                        } else {
                            bat "mvnw.cmd -B sonar:sonar -Dsonar.projectKey=%SONAR_PROJECT_KEY%"
                        }
                    }
                }
            }
        }

        stage('Pull Docker Image (Optional)') {
            steps {
                script {
                    if (isUnix()) {
                        sh """
                        docker pull ${IMAGE_NAME}:${params.IMAGE_TAG} || \
                        echo 'Image pull skipped (using local image if available).'
                        """
                    } else {
                        bat "docker pull %IMAGE_NAME%:${params.IMAGE_TAG} || echo Image pull skipped (using local image if available)."
                    }
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                script {
                    if (isUnix()) {
                        sh "docker rm -f ${CONTAINER_NAME} || true"
                    } else {
                        bat "docker rm -f %CONTAINER_NAME% || exit /b 0"
                    }
                }
            }
        }

        stage('Run New Container') {
            steps {
                script {
                    if (isUnix()) {
                        sh """
                        docker run -d \
                          --name ${CONTAINER_NAME} \
                          -p ${HOST_PORT}:${APP_PORT} \
                          ${IMAGE_NAME}:${params.IMAGE_TAG}
                        """
                    } else {
                        bat "docker run -d --name %CONTAINER_NAME% -p %HOST_PORT%:%APP_PORT% %IMAGE_NAME%:${params.IMAGE_TAG}"
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CD finished: ${IMAGE_NAME}:${params.IMAGE_TAG} deployed after unit tests and SonarQube."
        }
        failure {
            echo 'CD failed. Check Docker logs and SonarQube.'
        }
    }
}

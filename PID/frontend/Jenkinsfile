// Docker Hub: lfray | Registry credential ID in Jenkins: registry-creds
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        IMAGE_NAME = 'lfray/pid-frontend'
        CD_JOB_NAME = 'pid-frontend-cd'
        DOCKER_REGISTRY_CREDS_ID = 'registry-creds'
        SERVICE_DIR = 'PID/frontend'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        if (isUnix()) {
                            docker.image('node:20-alpine').inside {
                                sh 'npm ci'
                            }
                        } else {
                            bat 'npm ci'
                        }
                    }
                }
            }
        }

        stage('Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        if (isUnix()) {
                            docker.image('node:20-alpine').inside {
                                sh 'npm run build -- --configuration production'
                            }
                        } else {
                            bat 'npm run build -- --configuration production'
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        def tag = "${env.BUILD_NUMBER}"
                        if (isUnix()) {
                            sh "docker build -f Dockerfile.ci -t ${env.IMAGE_NAME}:${tag} -t ${env.IMAGE_NAME}:latest ."
                        } else {
                            bat "docker build -f Dockerfile.ci -t %IMAGE_NAME%:%BUILD_NUMBER% -t %IMAGE_NAME%:latest ."
                        }
                    }
                }
            }
        }

        stage('Docker Push') {
            when {
                expression { return (env.DOCKER_REGISTRY_CREDS_ID ?: '').trim().length() > 0 }
            }
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        withCredentials([usernamePassword(credentialsId: env.DOCKER_REGISTRY_CREDS_ID.trim(), usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                            if (isUnix()) {
                                sh """
                                    set +x
                                    echo "\${REG_PASS}" | docker login -u "\${REG_USER}" --password-stdin
                                    set -e
                                    docker push ${env.IMAGE_NAME}:${env.BUILD_NUMBER}
                                    docker push ${env.IMAGE_NAME}:latest
                                """
                            } else {
                                powershell """
                                    \$ErrorActionPreference = 'Stop'
                                    \$env:REG_PASS | docker login -u \$env:REG_USER --password-stdin
                                    docker push "\$(\$env:IMAGE_NAME):\$(\$env:BUILD_NUMBER)"
                                    docker push "\$(\$env:IMAGE_NAME):latest"
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger CD Pipeline') {
            steps {
                script {
                    build job: "${CD_JOB_NAME}",
                          wait: false,
                          parameters: [
                              string(name: 'IMAGE_TAG', value: "${env.BUILD_NUMBER}")
                          ]
                }
            }
        }
    }
}


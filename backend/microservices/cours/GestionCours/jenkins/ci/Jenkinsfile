pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }

    environment {
        SONAR_PROJECT_KEY = 'microservice-cours'
        DOCKER_IMAGE = 'saifdenden/microservice-cours'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'gestion_cours',
                    credentialsId: 'github-token',
                    url: 'https://github.com/lamisbenhassine/Esprit-PI-4SAE10-2025-2026-SlangEngish.git'
            }
        }

        stage('Unit Tests') {
            steps {
                dir('backend/microservices/cours/GestionCours') {
                    sh 'mvn test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backend/microservices/cours/GestionCours') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend/microservices/cours/GestionCours') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY}'
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('backend/microservices/cours/GestionCours') {
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-token',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh "echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin"
                    sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
                    sh "docker push ${DOCKER_IMAGE}:latest"
                }
            }
        }
    }

    post {
        success {
            echo ' CI Cours réussi — image poussée sur Docker Hub !'
            echo ' CI Cours réussi — image poussée sur Docker Hub !'
        }
        failure {
            echo ' CI Cours échoué !'
        }
    }
}
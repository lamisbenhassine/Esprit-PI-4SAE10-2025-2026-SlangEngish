pipeline {
    agent any
    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }
    environment {
        DOCKERHUB_USER = "amounboukhris"
        IMAGE_NAME = "amounboukhris/pedianephro-forum"
        TAG = "${BUILD_NUMBER}"
        SERVICE_PATH = "BackEnd/Microservices/forum"
    }

    stages {

        /* ===================== CHECKOUT ===================== */

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'gestion_forum']],
                    extensions: [
                        [$class: 'CloneOption',
                            shallow: true,
                            depth: 1,
                            noTags: true,
                            timeout: 60
                        ]
                    ],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Manel-Elj/Esprit-PIDEV-4SAE10-2026-PediaNephro.git',
                        credentialsId: 'git-token',
                        refspec: '+refs/heads/gestion_forum:refs/remotes/origin/gestion_forum'
                    ]]
                ])
            }
        }

        /* ===================== BUILD ===================== */

        stage('Clean Install') {
            steps {
                dir("${SERVICE_PATH}") {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        /* ===================== TESTS ===================== */

        stage('Tests + Coverage') {
            steps {
                dir("${SERVICE_PATH}") {
                    sh 'mvn clean verify'
                }
            }
        }

        /* ===================== SONARQUBE ===================== */

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        dir("${SERVICE_PATH}") {
                            sh """
                                mvn sonar:sonar \
                                -Dsonar.login=$SONAR_TOKEN \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                            """
                        }
                    }
                }
            }
        }

        /* ===================== DOCKER BUILD ===================== */

        stage('Build Docker Image') {
            steps {
                dir("${SERVICE_PATH}") {
                    sh "docker build -t ${IMAGE_NAME}:${TAG} ."
                }
            }
        }

        /* ===================== DOCKER LOGIN + PUSH ===================== */

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-token',
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                        echo "$PASS" | docker login -u "$USER" --password-stdin
                        docker push ${IMAGE_NAME}:${TAG}
                    '''
                }
            }
        }

        /* ===================== TRIGGER CD ===================== */

        stage('Trigger CD Pipeline') {
            steps {
                build job: 'cd-pipeline',
                parameters: [
                    string(name: 'IMAGE_TAG', value: "${BUILD_NUMBER}")
                ]
            }
        }
    }

    post {
        always {
            sh 'docker logout'
        }
    }
}
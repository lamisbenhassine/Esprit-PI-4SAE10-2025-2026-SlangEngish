pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
    }

    environment {
        IMAGE_NAME   = "saifdenden/saifpidev"
        NAMESPACE    = "gestion-cours"
        SERVICE_PATH = "backend/microservices/cours/GestionCours"
        KUBECONFIG   = "/var/jenkins_home/.kube/config"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'gestion_cours',
                    url: 'https://github.com/lamisbenhassine/Esprit-PI-4SAE10-2025-2026-SlangEngish.git'
            }
        }

        stage('Verify Files') {
            steps {
                sh """
                    echo "=== Current directory ==="
                    pwd

                    echo "=== Verify service path ==="
                    ls -la

                    echo "=== K8S files ==="
                    ls -R ${SERVICE_PATH}/k8s
                """
            }
        }

        stage('Prepare Namespace') {
            steps {
                sh """
                    kubectl get namespace ${NAMESPACE} || \
                    kubectl create namespace ${NAMESPACE}
                """
            }
        }

        stage('Deploy MySQL') {
            steps {
                dir("${SERVICE_PATH}/k8s") {
                    sh """
                        echo "=== Deploying MySQL ==="

                        kubectl apply -f mysql-deployment.yaml -n ${NAMESPACE}
                        kubectl apply -f mysql-service.yaml -n ${NAMESPACE}

                        echo "=== Waiting for MySQL ==="

                        kubectl rollout status deployment/mysql \
                            -n ${NAMESPACE} \
                            --timeout=300s
                    """
                }
            }
        }

        stage('Deploy Application') {
            steps {
                dir("${SERVICE_PATH}/k8s") {
                    sh """
                        echo "=== Deploying Application ==="

                        kubectl apply -f deployment.yaml -n ${NAMESPACE}
                        kubectl apply -f service.yaml -n ${NAMESPACE}

                        echo "=== Updating image ==="

                        kubectl set image deployment/gestion-cours \
                        gestion-cours=${IMAGE_NAME}:${IMAGE_TAG} \
                        -n ${NAMESPACE}

                        echo "=== Waiting for rollout ==="

                        kubectl rollout status deployment/gestion-cours \
                        -n ${NAMESPACE} \
                        --timeout=300s
                    """
                }
            }
        }

        stage('Deploy Monitoring') {
            steps {
                sh """
                    kubectl get namespace monitoring || \
                    kubectl create namespace monitoring

                    helm repo add prometheus-community \
                    https://prometheus-community.github.io/helm-charts || true

                    helm repo update

                    helm status prometheus -n monitoring > /dev/null 2>&1 || \
                    helm install prometheus prometheus-community/kube-prometheus-stack \
                        --namespace monitoring \
                        --set grafana.service.type=NodePort \
                        --set grafana.service.nodePort=32000 \
                        --set prometheus.prometheusSpec.service.type=NodePort \
                        --timeout 10m
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                sh """
                    echo "=== Application Pods ==="
                    kubectl get pods -n ${NAMESPACE}

                    echo "=== Application Services ==="
                    kubectl get svc -n ${NAMESPACE}

                    echo "=== Monitoring Pods ==="
                    kubectl get pods -n monitoring
                """
            }
        }
    }

    post {

        success {
            sh """
                echo "=================================="
                echo "DEPLOYMENT SUCCESS"
                echo "=================================="

                MINIKUBE_IP=\$(minikube ip)

                echo "Grafana:"
                echo "http://\${MINIKUBE_IP}:32000"

                echo "Prometheus:"
                echo "http://\${MINIKUBE_IP}:9090"
            """
        }

        failure {
            sh """
                echo "=================================="
                echo "DEPLOYMENT FAILED"
                echo "=================================="

                echo "=== EVENTS ==="
                kubectl get events -n ${NAMESPACE} \
                --sort-by=.lastTimestamp | tail -20 || true

                echo "=== PODS ==="
                kubectl get pods -n ${NAMESPACE} || true

                echo "=== DESCRIBE PODS ==="
                kubectl describe pods -n ${NAMESPACE} || true
            """
        }
    }
}

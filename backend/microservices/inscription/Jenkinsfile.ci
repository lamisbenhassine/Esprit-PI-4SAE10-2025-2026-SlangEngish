pipeline {
  agent any

  options {
    timestamps()
    skipDefaultCheckout(true)
  }

  environment {
    SERVICE_DIR = 'backend/microservices/inscription'
    SONAR_PROJECT_KEY = 'inscription'
    IMAGE_NAME = 'isra50/inscription'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def remote = scm.userRemoteConfigs[0]
          def branchSpec = scm.branches[0].name
          def branchName = branchSpec.replaceFirst('^\\*/', '')

          // Force a narrow refspec (avoid fetching all branches: +refs/heads/*)
          def refspec = "+refs/heads/${branchName}:refs/remotes/origin/${branchName}"

          withEnv([
            'GIT_HTTP_VERSION=HTTP/1.1',
            'GIT_HTTP_LOW_SPEED_LIMIT=1000',
            'GIT_HTTP_LOW_SPEED_TIME=600'
          ]) {
            checkout([
              $class: 'GitSCM',
              branches: [[name: "*/${branchName}"]],
              extensions: [
                [$class: 'CloneOption', timeout: 120, shallow: true, depth: 1, noTags: true, honorRefspec: true],
                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                  [$class: 'SparseCheckoutPath', path: 'backend/microservices/inscription']
                ]]
              ],
              userRemoteConfigs: [[
                name: remote.name ?: 'origin',
                url: remote.url,
                credentialsId: remote.credentialsId,
                refspec: refspec
              ]]
            ])
          }
        }
      }
    }

    stage('Build + Unit Tests + JaCoCo') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (isUnix()) {
              sh 'chmod +x mvnw'
              sh './mvnw -B clean verify'
            } else {
              bat 'mvnw.cmd -B clean verify'
            }
          }
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'backend/microservices/inscription/target/surefire-reports/*.xml'
          archiveArtifacts allowEmptyArchive: true, artifacts: 'backend/microservices/inscription/target/site/jacoco/**'
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        dir("${env.SERVICE_DIR}") {
          withSonarQubeEnv('sonarqube') {
            script {
              if (isUnix()) {
                sh """
                  ./mvnw -B sonar:sonar \
                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                    -Dsonar.projectName=inscription \
                    -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                """
              } else {
                bat """
                  mvnw.cmd -B sonar:sonar ^
                    -Dsonar.projectKey=${SONAR_PROJECT_KEY} ^
                    -Dsonar.projectName=inscription ^
                    -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                """
              }
            }
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: false
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (isUnix()) {
              sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
            } else {
              bat "docker build -t %IMAGE_NAME%:%BUILD_NUMBER% ."
            }
          }
        }
      }
    }

    stage('Push Docker Image') {
      steps {
        dir("${env.SERVICE_DIR}") {
          withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
            script {
              if (isUnix()) {
                sh '''
                  echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                  docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
              } else {
                bat '''
                  echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                  docker push %IMAGE_NAME%:%BUILD_NUMBER%
                '''
              }
            }
          }
        }
      }
    }

    stage('Trigger CD') {
      steps {
        script {
          // Trigger downstream CD pipeline after successful CI stages.
          // IMPORTANT: replace 'inscription-cd' with the exact Jenkins job name.
          def cdBuild = build job: 'inscription-cd',
                             wait: true,
                             propagate: false,
                             parameters: [
                               string(name: 'IMAGE_TAG', value: "${env.BUILD_NUMBER}")
                             ]

          echo "CD job inscription-cd finished with status: ${cdBuild?.result}"
        }
      }
    }
  }
}

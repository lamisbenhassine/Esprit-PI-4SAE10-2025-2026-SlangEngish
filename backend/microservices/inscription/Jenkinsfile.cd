pipeline {
  agent any

  options {
    timestamps()
    skipDefaultCheckout(true)
  }

  // Jenkins credential (Secret file): kubeconfig-kubeadm — kubeconfig du cluster kubeadm (API https://control-plane:6443)
  parameters {
    choice(name: 'DEPLOY_MODE', choices: ['kubectl', 'gitops'], description: 'kubectl = apply depuis Jenkins ; gitops = pousser le tag dans Git pour Argo CD')
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Tag Docker (ex. numéro de build CI)')
  }

  environment {
    SERVICE_DIR = 'backend/microservices/inscription'
    IMAGE_NAME = 'isra50/inscription'
    K8S_NAMESPACE = 'slangenglish'
    IMGTAG = "${params.IMAGE_TAG}"
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def remote = scm.userRemoteConfigs[0]
          def branchSpec = scm.branches[0].name
          def branchName = branchSpec.replaceFirst('^\\*/', '')

          env.GIT_BRANCH_TO_PUSH = branchName

          def refspec = "+refs/heads/${branchName}:refs/remotes/origin/${branchName}"

          withEnv([
            'GIT_HTTP_VERSION=HTTP/1.1',
            'GIT_HTTP_LOW_SPEED_LIMIT=1000',
            'GIT_HTTP_LOW_SPEED_TIME=600'
          ]) {
            checkout([
              $class: 'GitSCM',
              branches: [[name: "*/${branchName}"]],
              extensions: [
                [$class: 'CloneOption', timeout: 120, shallow: true, depth: 1, noTags: true, honorRefspec: true],
                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                  [$class: 'SparseCheckoutPath', path: 'backend/microservices/inscription'],
                  [$class: 'SparseCheckoutPath', path: 'gitops']
                ]]
              ],
              userRemoteConfigs: [[
                name: remote.name ?: 'origin',
                url: remote.url,
                credentialsId: remote.credentialsId,
                refspec: refspec
              ]]
            ])
          }
        }
      }
    }

    stage('Deploy To Kubernetes (kubectl)') {
      when {
        expression { params.DEPLOY_MODE == 'kubectl' }
      }
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            withCredentials([file(credentialsId: 'kubeconfig-kubeadm', variable: 'KUBECONFIG_FILE')]) {
              if (isUnix()) {
                sh '''
                  export KUBECONFIG="$KUBECONFIG_FILE"
                  kubectl config current-context
                  echo "API server:"
                  kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}{"\n"}' || true
                  kubectl get --raw='/version' >/dev/null
                  kubectl get namespace ${K8S_NAMESPACE} >/dev/null 2>&1 || kubectl create namespace ${K8S_NAMESPACE}
                  kubectl create secret generic inscription-secrets -n ${K8S_NAMESPACE} \
                    --from-literal=db-username=root \
                    --from-literal=db-password=change-me \
                    --dry-run=client -o yaml | kubectl apply -f -
                  sed -i 's/newTag: \\".*\\"/newTag: \\"'"${IMGTAG}"'\\"/' k8s/kustomization.yaml
                  kubectl apply --validate=false -k k8s/
                  if ! kubectl rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "MySQL rollout failed on first attempt. Restarting deployment and waiting again..."
                    kubectl get deployment mysql -n ${K8S_NAMESPACE} -o wide || true
                    kubectl get pods -n ${K8S_NAMESPACE} -l app=mysql -o wide || true
                    kubectl describe deployment mysql -n ${K8S_NAMESPACE} || true
                    kubectl describe pods -n ${K8S_NAMESPACE} -l app=mysql || true
                    kubectl rollout restart deployment/mysql -n ${K8S_NAMESPACE}
                    kubectl rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s
                  fi
                  if ! kubectl rollout status deployment/inscription -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "Rollout timeout. Collecting diagnostics..."
                    kubectl get deployment inscription -n ${K8S_NAMESPACE} -o wide || true
                    kubectl get pods -n ${K8S_NAMESPACE} -o wide || true
                    kubectl describe deployment inscription -n ${K8S_NAMESPACE} || true
                    kubectl describe pods -n ${K8S_NAMESPACE} || true
                    kubectl get events -n ${K8S_NAMESPACE} --sort-by=.metadata.creationTimestamp | tail -n 50 || true
                    exit 1
                  fi
                '''
              } else {
                bat '''
                  set KUBECONFIG=%KUBECONFIG_FILE%
                  kubectl config current-context
                  kubectl apply --validate=false -k k8s/
                  kubectl rollout status deployment/inscription -n %K8S_NAMESPACE% --timeout=300s
                '''
              }
            }
          }
        }
      }
    }

    stage('GitOps: push image tag (Argo CD)') {
      when {
        expression { params.DEPLOY_MODE == 'gitops' }
      }
      steps {
        script {
          if (!isUnix()) {
            error 'GitOps push stage requires a Unix shell (Linux agent or WSL).'
          }
          withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
            sh '''
              set -e
              cd "${WORKSPACE}"
              BRANCH="${GIT_BRANCH_TO_PUSH:-main}"
              TARGET="backend/microservices/inscription/k8s/kustomization.yaml"
              sed -i 's/newTag: \\".*\\"/newTag: \\"'"${IMGTAG}"'\\"/' "$TARGET"
              git config user.name "Jenkins"
              git config user.email "jenkins@localhost"
              git add "$TARGET"
              if git diff --staged --quiet; then
                echo "No change in kustomization (tag already ${IMGTAG})."
                exit 0
              fi
              git commit -m "chore(cd): inscription image tag ${IMGTAG}"
              REMOTE_URL="$(git remote get-url origin)"
              case "$REMOTE_URL" in
                git@*)
                  echo "Remote is SSH. Configure an HTTPS origin or add credentials compatible with SSH Agent."
                  exit 1
                  ;;
                https://*)
                  HOSTPATH="${REMOTE_URL#https://}"
                  PUSH_URL="https://${GIT_USER}:${GIT_PASS}@${HOSTPATH}"
                  git push "$PUSH_URL" "HEAD:refs/heads/${BRANCH}"
                  ;;
                *)
                  echo "Unsupported remote URL: ${REMOTE_URL}"
                  exit 1
                  ;;
              esac
            '''
          }
        }
      }
    }
  }
}

pipeline {
  agent any

  options {
    timestamps()
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
  }

  environment {
    SERVICE_DIR = 'backend/microservices/inscription'
    IMAGE_NAME = 'isra50/inscription'
    K8S_NAMESPACE = 'slangenglish'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def remote = scm.userRemoteConfigs[0]
          def branchSpec = scm.branches[0].name
          def branchName = branchSpec.replaceFirst('^\\*/', '')

          def refspec = "+refs/heads/${branchName}:refs/remotes/origin/${branchName}"

          withEnv([
            'GIT_HTTP_VERSION=HTTP/1.1',
            'GIT_HTTP_LOW_SPEED_LIMIT=1000',
            'GIT_HTTP_LOW_SPEED_TIME=600'
          ]) {
            checkout([
              $class: 'GitSCM',
              branches: [[name: "*/${branchName}"]],
              extensions: [
                [$class: 'CloneOption', timeout: 120, shallow: true, depth: 1, noTags: true, honorRefspec: true],
                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                  [$class: 'SparseCheckoutPath', path: 'backend/microservices/inscription']
                ]]
              ],
              userRemoteConfigs: [[
                name: remote.name ?: 'origin',
                url: remote.url,
                credentialsId: remote.credentialsId,
                refspec: refspec
              ]]
            ])
          }
        }
      }
    }

    stage('Build Jar') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (isUnix()) {
              sh 'chmod +x mvnw'
              sh './mvnw -B clean package -DskipTests'
            } else {
              bat 'mvnw.cmd -B clean package -DskipTests'
            }
          }
        }
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        dir("${env.SERVICE_DIR}") {
          withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
            script {
              if (isUnix()) {
                sh '''
                  echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                  docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
                retry(3) {
                  echo "Pushing Docker image ${IMAGE_NAME}:${IMAGE_TAG} (with retry)"
                  sh 'docker push ${IMAGE_NAME}:${IMAGE_TAG}'
                }
              } else {
                bat '''
                  echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                  docker build -t %IMAGE_NAME%:%IMAGE_TAG% .
                '''
                retry(3) {
                  echo "Pushing Docker image ${env.IMAGE_NAME}:${params.IMAGE_TAG} (with retry)"
                  bat 'docker push %IMAGE_NAME%:%IMAGE_TAG%'
                }
              }
            }
          }
        }
      }
    }

    stage('Deploy To Kubernetes') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            withCredentials([file(credentialsId: 'kubeconfig-minikube', variable: 'KUBECONFIG_FILE')]) {
              if (isUnix()) {
                sh '''
                  export KUBECONFIG="$KUBECONFIG_FILE"
                  kubectl config current-context
                  MINIKUBE_API_PORT="$(docker port minikube 8443/tcp | sed -E 's/.*:([0-9]+)$/\\1/' | head -n 1)"
                  if [ -z "$MINIKUBE_API_PORT" ]; then
                    echo "Unable to resolve Minikube API port from docker port output."
                    docker ps || true
                    exit 1
                  fi
                  KUBE_API_SERVER="https://host.docker.internal:${MINIKUBE_API_PORT}"
                  KUBE_TLS_FLAGS="--tls-server-name=minikube --insecure-skip-tls-verify=true"
                  echo "Using Kubernetes API endpoint: ${KUBE_API_SERVER}"
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get --raw='/version' >/dev/null
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get namespace ${K8S_NAMESPACE} >/dev/null 2>&1 || kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} create namespace ${K8S_NAMESPACE}
                  if [ -f k8s/secret.yaml ]; then
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/secret.yaml
                  elif [ -f k8s/secret.example.yaml ]; then
                    echo "k8s/secret.yaml not found, applying k8s/secret.example.yaml fallback."
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/secret.example.yaml
                  fi
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/mysql.yaml
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/configmap.yaml
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/service.yaml
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} apply --validate=false -f k8s/deployment.yaml
                  if ! kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "MySQL rollout failed on first attempt. Restarting deployment and waiting again..."
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get deployment mysql -n ${K8S_NAMESPACE} -o wide || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get pods -n ${K8S_NAMESPACE} -l app=mysql -o wide || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} describe deployment mysql -n ${K8S_NAMESPACE} || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} describe pods -n ${K8S_NAMESPACE} -l app=mysql || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} rollout restart deployment/mysql -n ${K8S_NAMESPACE}
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s
                  fi
                  kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} set image deployment/inscription inscription=${IMAGE_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE}
                  if ! kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} rollout status deployment/inscription -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "Rollout timeout. Collecting diagnostics..."
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get deployment inscription -n ${K8S_NAMESPACE} -o wide || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get pods -n ${K8S_NAMESPACE} -o wide || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} describe deployment inscription -n ${K8S_NAMESPACE} || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} describe pods -n ${K8S_NAMESPACE} || true
                    kubectl --server="${KUBE_API_SERVER}" ${KUBE_TLS_FLAGS} get events -n ${K8S_NAMESPACE} --sort-by=.metadata.creationTimestamp | tail -n 50 || true
                    exit 1
                  fi
                '''
              } else {
                bat '''
                  set KUBECONFIG=%KUBECONFIG_FILE%
                  kubectl config current-context
                  kubectl apply --validate=false -f k8s/mysql.yaml
                  kubectl apply --validate=false -f k8s/configmap.yaml
                  kubectl apply --validate=false -f k8s/service.yaml
                  kubectl apply --validate=false -f k8s/deployment.yaml
                  kubectl set image deployment/inscription inscription=%IMAGE_NAME%:%IMAGE_TAG% -n %K8S_NAMESPACE%
                  kubectl rollout status deployment/inscription -n %K8S_NAMESPACE% --timeout=300s
                '''
              }
            }
          }
        }
      }
    }
  }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'lfray/pid-notebook-service'
        CD_JOB_NAME = 'pid-notebook-cd'
        SONAR_PROJECT_KEY = 'pid-notebook-service'
        SONARQUBE_SERVER = 'sonarqube'
        DOCKER_REGISTRY_CREDS_ID = 'registry-creds'
        SERVICE_DIR = 'backend/microservices/notebook'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Unit Tests') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        if (isUnix()) {
                            sh 'chmod +x mvnw'
                            sh './mvnw -B clean test'
                        } else {
                            bat 'mvnw.cmd -B clean test'
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        withSonarQubeEnv("${SONARQUBE_SERVER}") {
                            if (isUnix()) {
                                sh "./mvnw -B sonar:sonar -Dsonar.projectKey=${SONAR_PROJECT_KEY}"
                            } else {
                                bat "mvnw.cmd -B sonar:sonar -Dsonar.projectKey=%SONAR_PROJECT_KEY%"
                            }
                            def sonarBase = env.SONAR_HOST_URL ?: 'http://localhost:9000'
                            echo "SonarQube — project overview: ${sonarBase}/dashboard?id=${SONAR_PROJECT_KEY}"
                            echo "SonarQube — coverage history (compare builds): ${sonarBase}/component_measures?id=${SONAR_PROJECT_KEY}&metric=coverage"
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        if (isUnix()) {
                            sh './mvnw -B package -DskipTests'
                        } else {
                            bat 'mvnw.cmd -B package -DskipTests'
                        }
                    }
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: "${SERVICE_DIR}/target/*.jar", fingerprint: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        def tag = "${env.BUILD_NUMBER}"
                        if (isUnix()) {
                            sh "docker build -t ${IMAGE_NAME}:${tag} -t ${IMAGE_NAME}:latest ."
                        } else {
                            bat "docker build -t ${IMAGE_NAME}:${tag} -t ${IMAGE_NAME}:latest ."
                        }
                    }
                }
            }
        }

        stage('Docker Push') {
            when {
                expression { return (env.DOCKER_REGISTRY_CREDS_ID ?: '').trim().length() > 0 }
            }
            steps {
                dir("${SERVICE_DIR}") {
                    script {
                        withCredentials([usernamePassword(credentialsId: env.DOCKER_REGISTRY_CREDS_ID.trim(), usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                            if (isUnix()) {
                                sh """
                                    set +x
                                    echo "\${REG_PASS}" | docker login -u "\${REG_USER}" --password-stdin
                                    set +e
                                    for attempt in 1 2 3; do
                                      set -x
                                      docker push ${env.IMAGE_NAME}:${env.BUILD_NUMBER} && docker push ${env.IMAGE_NAME}:latest
                                      rc=\$?
                                      set +x
                                      if [ \$rc -eq 0 ]; then exit 0; fi
                                      echo "Docker push failed (attempt \$attempt/3). Retrying in 60s (Docker Hub 400/timeouts are often transient)."
                                      sleep 60
                                    done
                                    exit 1
                                """
                            } else {
                                powershell """
                                    \$ErrorActionPreference = 'Stop'
                                    \$env:REG_PASS | docker login -u \$env:REG_USER --password-stdin
                                    docker push "\$(\$env:IMAGE_NAME):\$(\$env:BUILD_NUMBER)"
                                    docker push "\$(\$env:IMAGE_NAME):latest"
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger CD Pipeline') {
            steps {
                script {
                    build job: "${CD_JOB_NAME}",
                          wait: false,
                          parameters: [
                              string(name: 'IMAGE_TAG', value: "${env.BUILD_NUMBER}")
                          ]
                }
            }
        }
    }

    post {
        success {
            echo 'CI pipeline (notebook) finished successfully (unit tests + SonarQube + Docker).'
        }
        failure {
            echo 'CI pipeline (notebook) failed. Check logs, tests and SonarQube.'
        }
    }
}

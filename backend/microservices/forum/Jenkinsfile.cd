pipeline {
  agent any
  // Deploy: Jenkins credential Secret file id = kubeconfig-kubeadm (cluster kubeadm)

  options {
    timestamps()
    skipDefaultCheckout(true)
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
  }

  environment {
    SERVICE_DIR = 'backend/microservices/forum'
    IMAGE_NAME = 'isra50/forum'
    K8S_NAMESPACE = 'slangenglish'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def remote = scm.userRemoteConfigs[0]
          def branchSpec = scm.branches[0].name
          def branchName = branchSpec.replaceFirst('^\\*/', '')

          def refspec = "+refs/heads/${branchName}:refs/remotes/origin/${branchName}"

          withEnv([
            'GIT_HTTP_VERSION=HTTP/1.1',
            'GIT_HTTP_LOW_SPEED_LIMIT=1000',
            'GIT_HTTP_LOW_SPEED_TIME=600'
          ]) {
            checkout([
              $class: 'GitSCM',
              branches: [[name: "*/${branchName}"]],
              extensions: [
                [$class: 'CloneOption', timeout: 120, shallow: true, depth: 1, noTags: true, honorRefspec: true],
                [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                  [$class: 'SparseCheckoutPath', path: 'backend/microservices/forum']
                ]]
              ],
              userRemoteConfigs: [[
                name: remote.name ?: 'origin',
                url: remote.url,
                credentialsId: remote.credentialsId,
                refspec: refspec
              ]]
            ])
          }
        }
      }
    }

    stage('Build Jar') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (isUnix()) {
              sh 'chmod +x mvnw'
              sh './mvnw -B clean package -DskipTests'
            } else {
              bat 'mvnw.cmd -B clean package -DskipTests'
            }
          }
        }
      }
    }

    stage('Build & Push Docker Image') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (!fileExists('Dockerfile')) {
              echo 'Skipping Docker build/push: Dockerfile not found in forum service.'
              return
            }

            withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
              if (isUnix()) {
                sh '''
                  echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                  docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
                retry(3) {
                  echo "Pushing Docker image ${IMAGE_NAME}:${IMAGE_TAG} (with retry)"
                  sh 'docker push ${IMAGE_NAME}:${IMAGE_TAG}'
                }
              } else {
                bat '''
                  echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin
                  docker build -t %IMAGE_NAME%:%IMAGE_TAG% .
                '''
                retry(3) {
                  echo "Pushing Docker image ${env.IMAGE_NAME}:${params.IMAGE_TAG} (with retry)"
                  bat 'docker push %IMAGE_NAME%:%IMAGE_TAG%'
                }
              }
            }
          }
        }
      }
    }

    stage('Deploy To Kubernetes') {
      steps {
        dir("${env.SERVICE_DIR}") {
          script {
            if (!fileExists('k8s/deployment.yaml')) {
              echo 'Skipping Kubernetes deploy: k8s/deployment.yaml not found for forum service.'
              return
            }

            withCredentials([file(credentialsId: 'kubeconfig-kubeadm', variable: 'KUBECONFIG_FILE')]) {
              if (isUnix()) {
                sh '''
                  export KUBECONFIG="$KUBECONFIG_FILE"
                  kubectl config current-context
                  kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}{"\n"}' || true
                  kubectl get --raw='/version' >/dev/null
                  kubectl get namespace ${K8S_NAMESPACE} >/dev/null 2>&1 || kubectl create namespace ${K8S_NAMESPACE}
                  kubectl apply --validate=false -f k8s/mysql.yaml
                  kubectl apply --validate=false -f k8s/configmap.yaml
                  kubectl apply --validate=false -f k8s/service.yaml
                  kubectl apply --validate=false -f k8s/deployment.yaml
                  if ! kubectl rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "MySQL rollout failed on first attempt. Restarting deployment and waiting again..."
                    kubectl get deployment mysql -n ${K8S_NAMESPACE} -o wide || true
                    kubectl get pods -n ${K8S_NAMESPACE} -l app=mysql -o wide || true
                    kubectl describe deployment mysql -n ${K8S_NAMESPACE} || true
                    kubectl describe pods -n ${K8S_NAMESPACE} -l app=mysql || true
                    kubectl rollout restart deployment/mysql -n ${K8S_NAMESPACE}
                    kubectl rollout status deployment/mysql -n ${K8S_NAMESPACE} --timeout=900s
                  fi
                  kubectl set image deployment/forum forum=${IMAGE_NAME}:${IMAGE_TAG} -n ${K8S_NAMESPACE}
                  if ! kubectl rollout status deployment/forum -n ${K8S_NAMESPACE} --timeout=900s; then
                    echo "Rollout timeout. Collecting diagnostics..."
                    kubectl get deployment forum -n ${K8S_NAMESPACE} -o wide || true
                    kubectl get pods -n ${K8S_NAMESPACE} -o wide || true
                    kubectl describe deployment forum -n ${K8S_NAMESPACE} || true
                    kubectl describe pods -n ${K8S_NAMESPACE} || true
                    kubectl get events -n ${K8S_NAMESPACE} --sort-by=.metadata.creationTimestamp | tail -n 50 || true
                    exit 1
                  fi
                '''
              } else {
                bat '''
                  set KUBECONFIG=%KUBECONFIG_FILE%
                  kubectl config current-context
                  kubectl apply --validate=false -f k8s/mysql.yaml
                  kubectl apply --validate=false -f k8s/configmap.yaml
                  kubectl apply --validate=false -f k8s/service.yaml
                  kubectl apply --validate=false -f k8s/deployment.yaml
                  kubectl set image deployment/forum forum=%IMAGE_NAME%:%IMAGE_TAG% -n %K8S_NAMESPACE%
                  kubectl rollout status deployment/forum -n %K8S_NAMESPACE% --timeout=300s
                '''
              }
            }
          }
        }
      }
    }
  }
}
